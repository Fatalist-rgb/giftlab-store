# ─────────────────────────────────────────────────────────────────────────────
# Medusa backend environment. Copy this file to `.env` and fill in real values.
# The real `.env` is gitignored — never commit secrets.
# ─────────────────────────────────────────────────────────────────────────────

# Postgres connection string.
# Local dev: the portable build (repo README → `pnpm db:local:start`).
# Production: the Railway-managed Postgres URL.
DATABASE_URL=postgres://giftlab:giftlab@localhost:5432/giftlab

# Redis. Optional in development — Medusa falls back to in-memory modules
# (event bus, cache, workflow engine). Required in production.
REDIS_URL=redis://localhost:6379

# Secrets — generate strong random values for production, e.g. `openssl rand -hex 32`.
JWT_SECRET=change-me-in-production
COOKIE_SECRET=change-me-in-production
AUTH_MFA_ENCRYPTION_KEY=change-me-in-production-32-byte-hex

# CORS allow-lists (comma-separated). Point these at the deployed URLs in production.
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:5173,http://localhost:9000

# Admin onboarding flow shown on first run.
MEDUSA_ADMIN_ONBOARDING_TYPE=default
