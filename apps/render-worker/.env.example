# ─────────────────────────────────────────────────────────────────────────────
# Render worker environment. Copy to `.env` and fill in real values.
# Without the R2_* values the worker runs against local disk, so development
# works with no cloud account at all.
# ─────────────────────────────────────────────────────────────────────────────

# Queue (BullMQ).
REDIS_URL=redis://localhost:6379

# Completion hook: where to report finished packages (the Medusa backend) and the
# shared token both sides must agree on (RENDER_HOOK_TOKEN on the backend too).
RENDER_HOOK_URL=http://localhost:9000/hooks/gl/render-complete
RENDER_HOOK_TOKEN=

# ── Cloudflare R2 (production storage) ───────────────────────────────────────
# From the Cloudflare dashboard: R2 → Manage R2 API Tokens (Object Read & Write).
# Never commit the real values — this file is the template, `.env` is gitignored.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=giftlab-prod
# Jurisdiction of the bucket. "eu" keeps all objects in the EU (RODO) and changes the
# endpoint host — set it to match how the bucket was created.
R2_JURISDICTION=eu
# Optional: public base URL if the bucket serves customer-facing previews.
R2_PUBLIC_BASE=

# ── Local development fallbacks (used when R2_* is empty) ────────────────────
# Where schema asset keys ("/art/body-blue.png") are resolved from.
GL_ASSET_ROOT=../storefront/public
# Where finished production packages are written.
GL_OUT_DIR=./out
