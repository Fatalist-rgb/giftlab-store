# ─────────────────────────────────────────────────────────────────────────────
# Storefront environment. Copy to `.env.local` and fill in real values.
# Without these the storefront still runs: the constructor falls back to the
# local demo schema (see src/lib/backend.ts).
# ─────────────────────────────────────────────────────────────────────────────

# Medusa backend base URL (local dev: the `medusa develop` server).
MEDUSA_BACKEND_URL=http://localhost:9000

# Publishable API key from the Medusa admin (Settings → API key management).
# Required by every /store route.
MEDUSA_PUBLISHABLE_KEY=pk_replace_me

# The Medusa product whose constructor schema this storefront renders.
MEDUSA_FIGURINE_PRODUCT_ID=prod_belly
