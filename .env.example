# =========================================================================
# GiftLab — environment template. Copy to .env and fill in.
# Values here are safe placeholders; real secrets come from the client's
# own accounts (see client-docs "Perelik oblikovych zapysiv").
# =========================================================================

# --- Database / cache (local docker via `pnpm dev:infra`) ---
DATABASE_URL=postgres://giftlab:giftlab@localhost:5432/giftlab
REDIS_URL=redis://localhost:6379

# --- Cloudflare R2 (client account; blocked until provided) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=giftlab
R2_PUBLIC_BASE=

# --- Payments: Przelewy24 (sandbox until client merchant account) ---
P24_MERCHANT_ID=
P24_POS_ID=
P24_CRC=
P24_API_KEY=
P24_SANDBOX=true

# --- Background-removal provider (remove.bg / Photoroom / Clipdrop) ---
# `mock` returns a deterministic stub so the pipeline runs with no key.
CUTOUT_PROVIDER=mock
CUTOUT_API_KEY=

# --- Transactional email (Resend) ---
RESEND_API_KEY=
MAIL_FROM=hej@giftlab.pl

# --- Analytics (consent-gated; loaded only after cookie consent) ---
NEXT_PUBLIC_GTM_ID=

# --- i18n ---
LOCALES=pl,en,uk
DEFAULT_LOCALE=pl
